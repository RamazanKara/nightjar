{
  "cases": [
    {
      "name": "PC name",
      "secrets": [
        "Private desktop",
        "private-pc.lan"
      ],
      "input": "Private desktop is offline",
      "expect": "[PC] is offline"
    },
    {
      "name": "PC address",
      "secrets": [
        "Private desktop",
        "private-pc.lan"
      ],
      "input": "Unable to resolve host private-pc.lan",
      "expect": "Unable to resolve host [PC]"
    },
    {
      "name": "IPv6 secret before the patterns",
      "secrets": [
        "fd01::5"
      ],
      "input": "Unable to resolve host fd01::5",
      "expect": "Unable to resolve host [PC]"
    },
    {
      "name": "longest secret first",
      "secrets": [
        "desk",
        "desktop.local"
      ],
      "input": "desktop.local and desk",
      "expect": "[PC] and [PC]"
    },
    {
      "name": "a PC named PC does not mark the marks",
      "secrets": [
        "Gaming PC",
        "PC"
      ],
      "input": "Gaming PC wakes PC",
      "expect": "[PC] wakes [PC]"
    },
    {
      "name": "secrets are trimmed",
      "secrets": [
        " Living room "
      ],
      "input": "Living room PC",
      "expect": "[PC] PC"
    },
    {
      "name": "single characters are ignored",
      "secrets": [
        "x",
        " "
      ],
      "input": "x marks the spot",
      "expect": "x marks the spot"
    },
    {
      "name": "fixed events pass unchanged",
      "secrets": [
        "Stream"
      ],
      "input": "Stream connected",
      "expect": "Stream connected"
    },
    {
      "name": "other lines lose the secret",
      "secrets": [
        "Stream"
      ],
      "input": "Stream ended",
      "expect": "[PC] ended"
    }
  ]
}
