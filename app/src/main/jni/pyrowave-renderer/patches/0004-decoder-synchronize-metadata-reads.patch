Include dequantization metadata reads in the post-upload dependency.

The metadata is always read through a storage buffer, including when the
payload is sampled through a texel buffer or aliased linear image. Keep
sampled-read visibility for those payload paths and add storage-read
visibility for the metadata. Applies to PyroWave 502a3b52.

diff --git a/pyrowave_decoder.cpp b/pyrowave_decoder.cpp
index 429ba8b..d897913 100644
--- a/pyrowave_decoder.cpp
+++ b/pyrowave_decoder.cpp
@@ -879,7 +879,8 @@ bool Decoder::Impl::decode(CommandBuffer &cmd, const ViewBuffers &views)
 
 		cmd.barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
 		            VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
-		            use_readonly_texel_buffer ? VK_ACCESS_2_SHADER_SAMPLED_READ_BIT : VK_ACCESS_2_SHADER_STORAGE_READ_BIT);
+		            VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
+		            (use_readonly_texel_buffer ? VK_ACCESS_2_SHADER_SAMPLED_READ_BIT : 0));
 	}
 	cmd.end_region();
 
