+// The receive buffer holds RTP_RECV_PACKETS_BUFFERED packets, or about 60 ms of video when that
+// is more, so a stall of the receive thread doesn't drop packets at gigabit bitrates. The OS caps
+// the request at its own maximum.
+int videoRecvBufferSize(int bitrateKbps, int packetSize) {
+    long long packets = RTP_RECV_PACKETS_BUFFERED;
+    long long bytes = packets * (packetSize + MAX_RTP_HEADER_SIZE);
+    long long burst = (long long)bitrateKbps * 1000 / 8 * 60 / 1000;
+    if (burst > bytes) {
+        bytes = burst;
+    }
+    return bytes > 64 * 1024 * 1024 ? 64 * 1024 * 1024 : (int)bytes;
+}
