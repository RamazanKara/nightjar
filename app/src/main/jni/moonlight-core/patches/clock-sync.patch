Hand Rubylight clock sync replies (0x5537, protocol/core/src/control.rs) to the timestamp
presentation clock in android_present_clock.c. Only the size bounds are checked here; the
protocol library validates the reply. Nothing changes for hosts that never send it.
Applies after cursor-shape.patch.

diff --git a/src/ControlStream.c b/src/ControlStream.c
index c7b9c42..2ae4976 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -1,6 +1,7 @@
 #include "Limelight-internal.h"
 #include "ControllerHaptics.h"
 #include "cursor_shape.h"
+#include "clock_sync.h"
 
 // This is a private header, but it just contains some time macros
 #include <enet/time.h>
@@ -1507,6 +1508,13 @@ static void controlReceiveThreadFunc(void* context) {
                     Limelog("Dropping cursor shape message of %d bytes\n", length);
                 }
             }
+            else if (ctlHdr->type == RL_CLOCK_SYNC_MESSAGE_TYPE) {
+                int length = packetLength - (int)sizeof(*ctlHdr);
+                if (IS_SUNSHINE() && encryptedControlStream && length >= RL_CLOCK_SYNC_REPLY_BYTES &&
+                    length <= RL_CLOCK_SYNC_MAX_PAYLOAD) {
+                    BridgeClClockSync((const uint8_t*)(ctlHdr + 1), length);
+                }
+            }
             else if (needsAsyncCallback(ctlHdr->type)) {
                 queueAsyncCallback(ctlHdr, packetLength);
             }
