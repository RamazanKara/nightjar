     return networkGracePeriodMs > CONTROL_PEER_TIMEOUT_MS ? (enet_uint32)networkGracePeriodMs : CONTROL_PEER_TIMEOUT_MS;
 }
 
+#ifndef INPUT_CONTACT_LOST_MS
+#define INPUT_CONTACT_LOST_MS 1000
+#endif
+
+// True while a network grace period is set and nothing at all (not even an ack of the 100 ms
+// periodic ping) has come back from the host for INPUT_CONTACT_LOST_MS. The input stream holds
+// input back meanwhile: ENet would queue every input packet and deliver all of them, however
+// old, once the network returns. Without a grace period this is always false.
+bool isControlContactLost(void) {
+    ENetPeer* currentPeer = peer;
+    enet_uint32 lastReceiveTime;
+
+    if (networkGracePeriodMs <= CONTROL_PEER_TIMEOUT_MS || currentPeer == NULL) {
+        return false;
+    }
+
+    // Read without enetMutex like LiGetEstimatedRttInfo(): a torn read only shifts the moment
+    // input is held or released by one packet. A peer that timed out is not contact regained.
+    if (currentPeer->state != ENET_PEER_STATE_CONNECTED) {
+        return true;
+    }
+    lastReceiveTime = currentPeer->lastReceiveTime;
+    return lastReceiveTime != 0 && ENET_TIME_DIFFERENCE(enet_time_get(), lastReceiveTime) >= INPUT_CONTACT_LOST_MS;
+}
