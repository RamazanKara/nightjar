+static void holdInput(PHELD_INPUT slot, PPACKET_HOLDER holder, size_t size) {
+    LC_ASSERT(size <= sizeof(slot->packet));
+    slot->valid = true;
+    slot->channelId = holder->channelId;
+    slot->enetPacketFlags = holder->enetPacketFlags;
+    memcpy(&slot->packet, &holder->packet, size);
+}
+
+// Called on the input send thread for each packet while the host is silent
+static void holdInputForContact(PPACKET_HOLDER holder) {
+    uint32_t magic = LE32(holder->packet.header.magic);
+
+    if (!inputHeldForContact) {
+        Limelog("Input: no reply from the host, holding input until it is heard again\n");
+        inputHeldForContact = true;
+    }
+    heldInput.dropped++;
+
+    if (magic == KEY_DOWN_EVENT_MAGIC || magic == KEY_UP_EVENT_MAGIC) {
+        holdInput(&heldInput.keyboard[LE16(holder->packet.keyboard.keyCode) & 0xFF], holder, sizeof(NV_KEYBOARD_PACKET));
+    }
+    else if (magic == MOUSE_BUTTON_DOWN_EVENT_MAGIC_GEN5 || magic == MOUSE_BUTTON_UP_EVENT_MAGIC_GEN5) {
+        if (holder->packet.mouseButton.button < HELD_MOUSE_BUTTON_COUNT) {
+            holdInput(&heldInput.mouseButton[holder->packet.mouseButton.button], holder, sizeof(NV_MOUSE_BUTTON_PACKET));
+        }
+    }
+    else if (magic == MULTI_CONTROLLER_MAGIC_GEN5) {
+        uint16_t controllerNumber = LE16(holder->packet.multiController.controllerNumber);
+        if (controllerNumber < MAX_GAMEPADS) {
+            holdInput(&heldInput.controller[controllerNumber], holder, sizeof(NV_MULTI_CONTROLLER_PACKET));
+        }
+    }
+    else if (magic == SS_CONTROLLER_ARRIVAL_MAGIC) {
+        if (holder->packet.controllerArrival.controllerNumber < MAX_GAMEPADS) {
+            holdInput(&heldInput.controllerArrival[holder->packet.controllerArrival.controllerNumber], holder,
+                      sizeof(SS_CONTROLLER_ARRIVAL_PACKET));
+        }
+    }
+    else if (magic == SS_CONTROLLER_MOTION_MAGIC) {
+        uint8_t controllerNumber = holder->packet.controllerMotion.controllerNumber;
+        uint8_t motionType = holder->packet.controllerMotion.motionType;
+        if (controllerNumber < MAX_GAMEPADS && motionType >= 1 && motionType <= MAX_MOTION_EVENTS) {
+            holdInput(&heldInput.controllerMotion[controllerNumber][motionType - 1], holder, sizeof(SS_CONTROLLER_MOTION_PACKET));
+        }
+    }
+    else if (magic == SS_CONTROLLER_BATTERY_MAGIC) {
+        if (holder->packet.controllerBattery.controllerNumber < MAX_GAMEPADS) {
+            holdInput(&heldInput.controllerBattery[holder->packet.controllerBattery.controllerNumber], holder,
+                      sizeof(SS_CONTROLLER_BATTERY_PACKET));
+        }
+    }
+    else if (magic == SS_TOUCH_MAGIC) {
+        holdInput(&heldInput.touch, holder, sizeof(SS_TOUCH_PACKET));
+        heldInput.touch.packet.touch.eventType = LI_TOUCH_EVENT_CANCEL_ALL;
+        heldInput.touch.enetPacketFlags = ENET_PACKET_FLAG_RELIABLE;
+    }
+    else if (magic == SS_PEN_MAGIC) {
+        holdInput(&heldInput.pen, holder, sizeof(SS_PEN_PACKET));
+        heldInput.pen.packet.pen.eventType = LI_TOUCH_EVENT_CANCEL_ALL;
+        heldInput.pen.enetPacketFlags = ENET_PACKET_FLAG_RELIABLE;
+    }
+}
+
+static bool sendHeldInput(PHELD_INPUT slot) {
+    PACKET_HOLDER holder;
+
+    if (!slot->valid) {
+        return true;
+    }
+
+    if (isControlContactLost()) {
+        // Silent again: keep it for the next time the host is heard
+        inputHeldForContact = true;
+        return true;
+    }
+
+    slot->valid = false;
+    holder.channelId = slot->channelId;
+    holder.enetPacketFlags = slot->enetPacketFlags;
+    memcpy(&holder.packet, &slot->packet, sizeof(slot->packet));
+    return sendInputPacketNow(&holder, true);
+}
+
+static bool sendHeldInputWithMagic(PHELD_INPUT slots, int count, uint32_t magic) {
+    for (int i = 0; i < count; i++) {
+        if (slots[i].valid && LE32(slots[i].packet.header.magic) == magic && !sendHeldInput(&slots[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Sends the latest held state once the host is heard again. Releases go before presses.
+static bool sendInputHeldForContact(void) {
+    inputHeldForContact = false;
+    Limelog("Input: the host is heard again, sending the current input state in place of %u held packets\n",
+            heldInput.dropped);
+    heldInput.dropped = 0;
+
+    for (int i = 0; i < MAX_GAMEPADS; i++) {
+        if (!sendHeldInput(&heldInput.controllerArrival[i])) {
+            return false;
+        }
+    }
+    if (!sendHeldInputWithMagic(heldInput.keyboard, HELD_KEY_COUNT, KEY_UP_EVENT_MAGIC) ||
+        !sendHeldInputWithMagic(heldInput.mouseButton, HELD_MOUSE_BUTTON_COUNT, MOUSE_BUTTON_UP_EVENT_MAGIC_GEN5) ||
+        !sendHeldInputWithMagic(heldInput.keyboard, HELD_KEY_COUNT, KEY_DOWN_EVENT_MAGIC) ||
+        !sendHeldInputWithMagic(heldInput.mouseButton, HELD_MOUSE_BUTTON_COUNT, MOUSE_BUTTON_DOWN_EVENT_MAGIC_GEN5)) {
+        return false;
+    }
+    for (int i = 0; i < MAX_GAMEPADS; i++) {
+        if (!sendHeldInput(&heldInput.controller[i]) ||
+            !sendHeldInput(&heldInput.controllerMotion[i][0]) ||
+            !sendHeldInput(&heldInput.controllerMotion[i][1]) ||
+            !sendHeldInput(&heldInput.controllerBattery[i])) {
+            return false;
+        }
+    }
+    if (!sendHeldInput(&heldInput.touch) || !sendHeldInput(&heldInput.pen)) {
+        return false;
+    }
+
+    flushInputOnControlStream();
+    return true;
+}
+
+// Called by the control stream's receive thread while a network grace period is set
+void wakeInputAfterContactLoss(void) {
+    if (inputHeldForContact && !isControlContactLost()) {
+        LbqSignalQueueUserWake(&packetQueue);
+    }
+}
+
+static bool sendInputPacket(PPACKET_HOLDER holder, bool moreData) {
+    if (inputHeldForContact && !isControlContactLost() && !sendInputHeldForContact()) {
+        return false;
+    }
+    if (isControlContactLost()) {
+        holdInputForContact(holder);
+        return true;
+    }
+    return sendInputPacketNow(holder, moreData);
+}
