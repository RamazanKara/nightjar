Hand host cursor shape messages (0x5541, docs/protocol/cursor-shape.md) to the Android bridge.
Only the size bounds are checked here; Java validates and decodes them off this thread, and the
bridge drops them unless this client asked for shapes. Nothing changes for hosts that never send it.
Applies after host-timing.patch.

diff --git a/src/ControlStream.c b/src/ControlStream.c
index 6b3f0c6..037b708 100644
--- a/src/ControlStream.c
+++ b/src/ControlStream.c
@@ -1,5 +1,6 @@
 #include "Limelight-internal.h"
 #include "ControllerHaptics.h"
+#include "cursor_shape.h"
 
 // This is a private header, but it just contains some time macros
 #include <enet/time.h>
@@ -1449,6 +1450,17 @@ static void controlReceiveThreadFunc(void* context) {
                     BridgeClHostTiming((const uint8_t*)(ctlHdr + 1), length);
                 }
             }
+            else if (ctlHdr->type == RL_CURSOR_SHAPE_MESSAGE_TYPE) {
+                const uint8_t* payload = (const uint8_t*)(ctlHdr + 1);
+                int length = packetLength - (int)sizeof(*ctlHdr);
+                if (IS_SUNSHINE() && encryptedControlStream && length >= RL_CURSOR_SHAPE_HEADER_BYTES &&
+                    length <= RL_CURSOR_SHAPE_MAX_PAYLOAD) {
+                    BridgeClCursorShape(payload, length);
+                }
+                else {
+                    Limelog("Dropping cursor shape message of %d bytes\n", length);
+                }
+            }
             else if (needsAsyncCallback(ctlHdr->type)) {
                 queueAsyncCallback(ctlHdr, packetLength);
             }
