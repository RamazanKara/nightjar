<?xml version="1.0" encoding="utf-8"?>
<!-- A game on a Home shelf on TV: a 2:3 poster and nothing else (the hero names the focused game). Like the library poster
     (layout-television/app_grid_item.xml) the glow is a view under the card and the ring one around it, in the root's padding;
     the root's animator scales and lifts the lot. The padding is only the gap between cards: the glow reaches past it
     and the lists above this card do not clip it.
     ShelfAdapter sets the poster height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="@dimen/cover_inset" android:clipChildren="false" android:clipToPadding="false"
    android:focusable="true" android:clickable="true" android:defaultFocusHighlightEnabled="false"
    android:stateListAnimator="?attr/nightjarPosterFocusAnimator" android:descendantFocusability="blocksDescendants">
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="-16dp" android:layout_marginEnd="-16dp" android:layout_marginTop="-16dp" android:layout_marginBottom="-16dp" android:background="?attr/nightjarPosterGlow"
        android:duplicateParentState="true" android:importantForAccessibility="no" />
    <com.google.android.material.card.MaterialCardView
        app:cardPreventCornerOverlap="false" android:clipToOutline="true"
        android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/LibraryPoster"
        android:duplicateParentState="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:duplicateParentState="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <FrameLayout android:id="@+id/console_cover_frame" android:layout_width="match_parent" android:layout_height="160dp"
                    android:background="?attr/colorSurfaceContainerHigh">
                    <com.limelight.ui.PosterImageView android:id="@+id/console_cover" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/console_cover_text" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:padding="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface"
                        android:maxLines="4" android:ellipsize="end" android:importantForAccessibility="no" />
                    <!-- Running (with the live dot) or Suspended. -->
                    <TextView android:id="@+id/console_badge" style="@style/Widget.Nightjar.CardChip"
                        android:layout_gravity="top|start" android:layout_margin="@dimen/space_s"
                        android:visibility="gone" />
                    <!-- The top end: a favourite's star, then the store's glyph (or name) in the corner. A cover's own
                         title or logo art sits at its foot, so the store's mark stays up here. -->
                    <LinearLayout android:id="@+id/console_marks" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_gravity="top|end"
                        android:layout_margin="@dimen/space_s" android:orientation="horizontal">
                        <ImageView android:id="@+id/console_star" android:layout_width="@dimen/card_chip_height"
                            android:layout_height="@dimen/card_chip_height" android:layout_marginEnd="@dimen/space_xs"
                            android:padding="5dp" android:background="@drawable/bg_card_star"
                            android:src="@drawable/ic_star_filled" app:tint="@color/night_primary"
                            android:visibility="gone" android:importantForAccessibility="no" />
                        <TextView android:id="@+id/console_store_mark" style="@style/Widget.Nightjar.CardChip"
                            android:visibility="gone" />
                    </LinearLayout>
                    <!-- Not installed, or what adding takes. -->
                    <TextView android:id="@+id/console_store" style="@style/Widget.Nightjar.CardChip"
                        android:layout_gravity="bottom|start" android:layout_margin="@dimen/space_s"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="-5dp" android:layout_marginEnd="-5dp" android:layout_marginTop="-5dp" android:layout_marginBottom="-5dp"
        android:background="?attr/nightjarPosterRing" android:duplicateParentState="true"
        android:importantForAccessibility="no" />
</FrameLayout>
