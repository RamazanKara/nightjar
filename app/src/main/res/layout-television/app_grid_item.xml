<?xml version="1.0" encoding="utf-8"?>
<!-- A game in the TV library: a large 2:3 poster. It shows art only: the focused game's title is in the library's focus line, and it is also in the
     card's contentDescription. A game without art keeps its centered title. The root's padding is the glow's
     reach (16dp): the glow view fills the root and draws under the card, the ring is a view around the poster, in the padding, so it never covers the art, and the
     root's animator scales and lifts the lot. AppGridAdapter fills it; GenericGridAdapter sets the poster height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="@dimen/poster_glow" android:clipChildren="false" android:clipToPadding="false"
    android:stateListAnimator="?attr/nightjarPosterFocusAnimator" android:descendantFocusability="blocksDescendants">
    <View android:id="@+id/grid_glow" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="-16dp" android:layout_marginEnd="-16dp" android:layout_marginTop="-16dp" android:layout_marginBottom="-16dp" android:background="?attr/nightjarPosterGlow"
        android:duplicateParentState="true" android:importantForAccessibility="no" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/grid_card"
        app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent" android:clipToOutline="true"
        android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/LibraryPoster"
        android:duplicateParentState="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="224dp"
            android:background="?attr/colorSurfaceContainerHigh" android:duplicateParentState="true">
            <com.limelight.ui.PosterImageView android:id="@+id/grid_image" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/grid_text" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:padding="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface"
                android:maxLines="4" android:ellipsize="end" android:importantForAccessibility="no" />
            <!-- The badges sit at the top start, as on a phone: a cover prints its own title along the bottom. The end margin
                 keeps a long role chip clear of the options button at the top end. -->
            <LinearLayout android:id="@+id/grid_badges" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|start" android:layout_marginStart="@dimen/space_xs" android:layout_marginTop="@dimen/space_xs"
                android:layout_marginEnd="@dimen/touch_target" android:orientation="vertical">
                <TextView android:id="@+id/grid_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:background="@drawable/bg_chip"
                    android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" android:importantForAccessibility="no" />
                <TextView android:id="@+id/grid_role" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs"
                    android:maxLines="1" android:ellipsize="end" android:background="@drawable/bg_chip" android:drawablePadding="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" android:importantForAccessibility="no" />
            </LinearLayout>
            <ImageButton android:id="@+id/grid_more" style="@style/ToolbarIcon" android:layout_gravity="top|end"
                android:padding="@dimen/space_l" android:background="@drawable/bg_cover_action" android:focusable="false"
                android:importantForAccessibility="yes" android:src="@drawable/ic_library_more" android:contentDescription="@string/library_options" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <View android:id="@+id/grid_ring" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="-5dp" android:layout_marginEnd="-5dp" android:layout_marginTop="-5dp" android:layout_marginBottom="-5dp"
        android:background="?attr/nightjarPosterRing" android:duplicateParentState="true"
        android:importantForAccessibility="no" />
</FrameLayout>
