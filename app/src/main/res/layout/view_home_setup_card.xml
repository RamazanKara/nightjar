<?xml version="1.0" encoding="utf-8"?>
<!-- Home's set-up card (SetupCard): after the first pairing it says what the automatic settings will use for this
     device and that PC. Nothing to press but its close button; it stays until that is chosen. A screen reader hears the
     two lines as one stop, then the button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_setup_card" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/glass_notice"
    android:paddingStart="@dimen/space_l" android:paddingEnd="@dimen/space_xs"
    android:paddingTop="@dimen/space_s" android:paddingBottom="@dimen/space_s" android:visibility="gone">
    <LinearLayout android:id="@+id/home_setup_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:focusable="false" android:importantForAccessibility="yes">
        <TextView android:id="@+id/home_setup_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="@dimen/home_setup_card_text" android:maxLines="2" android:ellipsize="end"
            android:breakStrategy="balanced"
            android:fontFamily="?attr/nightjarFaceStrong" android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/home_setup_values" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="@dimen/home_setup_card_text" android:layout_marginTop="2dp" android:maxLines="3" android:ellipsize="end"
            android:breakStrategy="balanced"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <!-- A FrameLayout: its foreground, the focus ring, draws on every Android this runs on. -->
    <FrameLayout android:id="@+id/home_setup_dismiss" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target"
        android:layout_marginStart="@dimen/space_xs" android:clickable="true" android:focusable="true"
        android:defaultFocusHighlightEnabled="false"
        android:foreground="@drawable/focus_ring_row" android:contentDescription="@string/home_setup_dismiss">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center"
            android:src="@drawable/ic_close" app:tint="?attr/colorOnSurface" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
