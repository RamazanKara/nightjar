<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include android:id="@+id/host_profile_toolbar" layout="@layout/view_top_app_bar" />
        <FrameLayout android:id="@+id/host_profile_settings" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/host_profile_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter" android:paddingTop="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/host_profile_save"
            android:nextFocusUp="@android:id/list" android:accessibilityTraversalAfter="@android:id/list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_gutter" android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_marginTop="@dimen/space_m" android:layout_marginBottom="@dimen/space_l"
            android:minHeight="@dimen/touch_target" android:text="@string/host_profile_save" />
    </LinearLayout>
</com.limelight.ui.ContentFrame>
