<?xml version="1.0" encoding="utf-8"?>
<!-- Home, PCs and Settings under the top app bar. Include it as @id/shell_bar and fill it with com.limelight.ui.ShellBar;
     it scrolls sideways when a long translation does not fit. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_bar"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:scrollbars="none" android:fillViewport="true" android:overScrollMode="never"
    android:clipToPadding="false" android:focusable="false" android:defaultFocusHighlightEnabled="false"
    android:paddingStart="@dimen/shell_inset" android:paddingEnd="@dimen/shell_inset"
    android:paddingTop="2dp" android:paddingBottom="@dimen/space_s">
    <LinearLayout android:id="@+id/shell_bar_items"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" />
</HorizontalScrollView>
