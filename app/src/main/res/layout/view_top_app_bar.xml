<?xml version="1.0" encoding="utf-8"?>
<!-- The one top app bar. Include it with a screen-specific android:id and configure it with
     com.limelight.ui.TopAppBar; its look comes from Widget.Nightjar.Toolbar via the theme's toolbarStyle. -->
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_app_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/top_app_bar_height" />
