<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's hero: the game's name and when it was played, on its art on the stage, then a carousel of large covers and,
     under the one in the middle with the standard gap, the solid Play. HomeHeroStage gives the words their top padding: the
     room in which the art shows above them, where the window is high enough for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:id="@+id/hero_words" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="@dimen/glass_edge" android:paddingEnd="@dimen/glass_edge" android:paddingBottom="@dimen/space_m">
        <TextView android:id="@+id/hero_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.Nightjar.Display" android:textColor="?attr/colorOnSurface" />
        <TextView android:id="@+id/hero_line" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" android:visibility="gone"
            android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    <TextView android:id="@+id/shelf_title" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/shelf_cards"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never"
        android:focusable="false" android:descendantFocusability="afterDescendants" />
    <com.limelight.ui.GlassButton android:id="@+id/hero_play" style="@style/Widget.Nightjar.Glass.Play"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="214dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s" android:text="@string/library_play" />
</LinearLayout>
