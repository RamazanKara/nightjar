<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN screen on phones in portrait: the prompt and dots above, the pad below. Landscape (TVs too) puts
     the prompt left of the pad: layout-land/activity_pin_lock.xml has the same ids. -->
<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_horizontal|center_vertical"
            android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_l" android:paddingBottom="@dimen/space_l">
            <ImageView android:id="@+id/pin_icon"
                android:layout_width="@dimen/pin_icon_size" android:layout_height="@dimen/pin_icon_size"
                android:src="@drawable/ic_lock" app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/pin_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle"
                android:textColor="?attr/colorOnSurface" android:accessibilityHeading="true" />
            <TextView android:id="@+id/pin_subtitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <LinearLayout android:id="@+id/pin_dots"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl" android:orientation="horizontal" />
            <TextView android:id="@+id/pin_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" android:layout_marginBottom="@dimen/space_m"
                android:minHeight="40dp" android:gravity="center"
                android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
                android:textColor="?attr/colorOnSurfaceVariant" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/pin_hint" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m" android:gravity="center"
                android:text="@string/pin_hint"
                android:textAppearance="@style/TextAppearance.Nightjar.Caption"
                android:textColor="?attr/colorOnSurfaceVariant" />
            <include layout="@layout/view_pin_pad" />
            <com.google.android.material.button.MaterialButton android:id="@+id/pin_cancel"
                style="?attr/nightjarButtonTextStyle" android:focusable="false"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />
        </LinearLayout>
    </ScrollView>
</com.limelight.ui.ContentFrame>
