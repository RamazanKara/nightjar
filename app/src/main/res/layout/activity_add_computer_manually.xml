<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include android:id="@+id/add_pc_toolbar" layout="@layout/view_top_app_bar" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
                android:paddingTop="@dimen/space_s" android:paddingBottom="@dimen/space_xl">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/add_pc_hint" android:textAppearance="@style/TextAppearance.Nightjar.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/host_input"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl" android:hint="@string/ip_hint"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/hostTextView"
                        android:nextFocusUp="@id/add_pc_back" android:nextFocusDown="@+id/addPcButton"
                        android:nextFocusForward="@id/addPcButton" android:accessibilityTraversalAfter="@id/add_pc_back"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:minHeight="56dp" android:singleLine="true" android:inputType="textUri"
                        android:textAppearance="@style/TextAppearance.Nightjar.Body">
                        <requestFocus />
                    </com.google.android.material.textfield.TextInputEditText>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/addPcButton"
                    android:nextFocusUp="@id/hostTextView" android:accessibilityTraversalAfter="@id/hostTextView"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:layout_marginTop="@dimen/space_l" android:text="@string/addpc_button" />
                <!-- Shown only on devices with a camera. -->
                <com.google.android.material.button.MaterialButton android:id="@+id/scanQrButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:nextFocusUp="@id/addPcButton" android:accessibilityTraversalAfter="@id/addPcButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
                    android:layout_marginTop="@dimen/space_m" android:text="@string/addpc_scan_qr"
                    android:visibility="gone" />
                <TextView android:id="@+id/scanQrHint"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/addpc_qr_hint" android:textAppearance="@style/TextAppearance.Nightjar.Body"
                    android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.limelight.ui.ContentFrame>
