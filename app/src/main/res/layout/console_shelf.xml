<?xml version="1.0" encoding="utf-8"?>
<!-- One shelf of Home: a heading over a row of cards. ConsoleHomeAdapter fills it; the cards scroll sideways on their own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipChildren="false" android:clipToPadding="false">
    <TextView android:id="@+id/shelf_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
        android:paddingTop="@dimen/space_xl" android:paddingBottom="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle" android:textColor="?attr/colorOnSurface"
        android:accessibilityHeading="true" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/shelf_cards"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never"
        android:paddingEnd="@dimen/shelf_keyline" android:focusable="false"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
