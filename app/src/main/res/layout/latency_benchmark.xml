<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_s" android:paddingBottom="@dimen/space_xl">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/latency_benchmark_description"
            android:textAppearance="@style/TextAppearance.Nightjar.Body" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmark_start"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l" android:minHeight="@dimen/touch_target"
            android:text="@string/latency_benchmark_start" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmark_share"
            style="@style/Widget.Nightjar.Button.Tonal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s" android:minHeight="@dimen/touch_target"
            android:text="@string/latency_benchmark_share" />
        <TextView android:id="@+id/benchmark_results"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l" android:textIsSelectable="true"
            android:textAppearance="@style/TextAppearance.Nightjar.Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl" android:text="@string/latency_benchmark_limits"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
