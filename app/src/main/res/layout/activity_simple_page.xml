<?xml version="1.0" encoding="utf-8"?>
<!-- A top app bar over one content area, for screens that are neither settings lists nor grids.
     com.limelight.ui.TopAppBar.setUpPage() inflates it; content goes into page_content. -->
<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <include android:id="@+id/page_toolbar" layout="@layout/view_top_app_bar" />
        <FrameLayout android:id="@+id/page_content"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</com.limelight.ui.ContentFrame>
