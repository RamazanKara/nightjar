        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Nightjar.ScreenTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Nightjar.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Nightjar.Title</item>
