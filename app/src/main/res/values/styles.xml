<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Application theme. Colour roles come from colors.xml, which follows the system's night mode
        (night is the default). Keep the non-colour items in step with Theme.Nightjar.Stream below;
        ThemePaletteTest checks that they match.
    -->
    <style name="Base.Theme.Nightjar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <item name="colorPrimary">@color/primary</item>
