        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:textColorAlertDialogListItem">@color/on_surface</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorControlNormal">@color/on_surface_variant</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="colorPrimaryFixed">@color/primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/primary_fixed_dim</item>
        <item name="colorOnPrimaryFixed">@color/on_primary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/on_primary_fixed_variant</item>
        <item name="colorSecondaryFixed">@color/secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/secondary_fixed_dim</item>
