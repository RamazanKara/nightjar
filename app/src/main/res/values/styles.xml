        <item name="nightjarButtonRestStroke">@android:color/transparent</item>
        <item name="nightjarCardFocusAnimator">@animator/tv_card_focus</item>
        <item name="nightjarControlFocusAnimator">@animator/tv_control_focus</item>
        <item name="nightjarPosterFocusAnimator">@animator/tv_poster_focus</item>
        <item name="nightjarPosterFocusAnimatorSmall">@animator/tv_poster_focus_small</item>
        <item name="nightjarPosterRing">@drawable/tv_poster_ring</item>
        <item name="nightjarPosterGlow">@drawable/tv_focus_glow_fade</item>
        <item name="nightjarTileFocusAnimator">@animator/tv_tile_focus</item>
        <item name="nightjarTileRing">@drawable/tv_tile_ring</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Nightjar</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Nightjar</item>
    </style>

    <style name="AppTheme" parent="Base.Theme.Nightjar" />

    <!--
