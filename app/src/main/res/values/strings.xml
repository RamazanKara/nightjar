    <string name="title_seekbar_deadzone">Analog stick deadzone</string>
    <string name="summary_seekbar_deadzone">Some games use a larger deadzone. Negative values push small movements outwards to overcome the built-in deadzone of a controller or game. Negative values also amplify resting-stick drift.</string>
    <string name="suffix_seekbar_deadzone">%</string>
    <string name="title_checkbox_xb1_driver">USB controller driver</string>
    <string name="summary_checkbox_xb1_driver">Built-in driver for Xbox controllers over USB. No root needed.</string>
    <string name="title_usb_dualsense_haptics">USB DualSense audio and haptics</string>
    <string name="summary_usb_dualsense_haptics">Detailed vibration from hosts that support DualSense haptics. Some hosts also carry the controller’s speaker, headset and microphone audio; the microphone also needs its own setting and permission. Reconnect the controller after changing this.</string>
    <string name="title_usb_dualsense">USB DualSense driver</string>
    <string name="summary_usb_dualsense">Use adaptive triggers, rumble and more over USB.</string>
    <string name="usb_dualsense_permission_info">Allow USB access when you start a stream.\nWithout it, adaptive triggers stay off.</string>
    <string name="usb_dualsense_enable">Enable USB driver</string>
    <string name="usb_dualsense_denied">No USB access; adaptive triggers are off.\nReconnect the cable to retry.</string>
    <string name="title_checkbox_usb_bind_all">Always use the USB driver</string>
    <string name="summary_checkbox_usb_bind_all">Use the built-in driver even for controllers that Android already supports.</string>
    <string name="title_checkbox_mouse_emulation">Controller mouse mode</string>
    <string name="summary_checkbox_mouse_emulation">Hold Start to switch the controller between gamepad and mouse.</string>
    <string name="title_checkbox_flip_face_buttons">Flip face buttons</string>
    <string name="summary_checkbox_flip_face_buttons">Swap A/B and X/Y on gamepads and on-screen controls</string>
    <string name="title_checkbox_gamepad_touchpad_as_mouse">Touchpad always moves mouse</string>
