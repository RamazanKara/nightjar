    <string name="category_gamepad_settings">Controllers</string>
    <string name="title_checkbox_multi_controller">Multiple controllers</string>
    <string name="summary_checkbox_multi_controller">On: each controller is its own player, and the PC sees a controller only while one is connected. Off: every controller acts as player 1, and the PC always sees one controller.</string>
    <string name="title_checkbox_vibrate_fallback">Vibrate device for rumble</string>
