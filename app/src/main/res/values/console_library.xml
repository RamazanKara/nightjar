<?xml version="1.0" encoding="utf-8"?>
<!-- The TV library's cards: the chips over a poster and the colours they need beside the theme's amber. -->
<resources>
    <!-- A game running now: the dot of the Running chip. Green reads as "live" next to the amber the rest of the app uses. -->
    <!-- The night ok tone in both themes, because the chip always sits on the dark scrim over art. -->
    <color name="status_live">@color/night_status_ok</color>
    <!-- Chips sit on any art: 72% black keeps 13sp white text above 7:1 on the brightest cover. -->
    <color name="card_chip_scrim">#B8000000</color>
    <color name="card_chip_text">#FFFFFFFF</color>

    <dimen name="card_chip_height">24dp</dimen>
    <dimen name="card_chip_glyph">14dp</dimen>

    <style name="TextAppearance.Nightjar.CardChip" parent="TextAppearance.Nightjar.Caption">
        <item name="android:textSize">13sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/card_chip_text</item>
    </style>

    <!-- The count on a row's "All N" tile. -->
    <style name="TextAppearance.Nightjar.TileCount" parent="TextAppearance.Nightjar.ScreenTitle">
        <item name="android:textSize">40sp</item>
        <item name="lineHeight">48sp</item>
    </style>

    <!-- One chip over a poster: a pill, its text or glyph white. -->
    <style name="Widget.Nightjar.CardChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/card_chip_height</item>
        <item name="android:minWidth">@dimen/card_chip_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:background">@drawable/bg_card_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Nightjar.CardChip</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- A filter above All games: a shell-bar item (amber container when chosen, amber ring on focus) with the store's
         glyph and the count. -->
    <style name="Widget.Nightjar.FilterChip" parent="Widget.Nightjar.ShellItem">
        <item name="iconSize">16dp</item>
        <item name="iconPadding">8dp</item>
        <item name="android:layout_marginEnd">@dimen/space_s</item>
    </style>
</resources>
