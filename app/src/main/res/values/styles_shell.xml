<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One destination in the shell bar (Home, PCs, Settings); the current one is selected. -->
    <style name="Widget.Nightjar.ShellItem" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/shell_item_text</item>
        <item name="iconTint">@color/shell_item_text</item>
        <item name="backgroundTint">@color/shell_item_background</item>
        <item name="strokeColor">@color/shell_item_stroke</item>
        <item name="strokeWidth">?attr/nightjarFocusRingWidth</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
