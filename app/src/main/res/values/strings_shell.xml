    <!-- Accessibility: interface size, high contrast and reduced motion. -->
    <string name="settings_category_accessibility">Accessibility</string>
    <string name="title_ui_scale">Interface size</string>
    <string name="summary_ui_scale">Scales the menus, lists and dialogs of the app. The stream is not scaled. The system font size still applies on top. Takes effect at once.</string>
    <string name="title_high_contrast">High contrast</string>
    <string name="summary_high_contrast">A black background, stronger text and outlines, and a thicker focus ring on every screen of the app. The stream is not changed.</string>
    <string name="title_reduce_motion">Reduce motion</string>
    <string name="summary_reduce_motion">Follow system turns animation off when Android’s animation scale is 0. Reduce replaces the focus zoom and the sliding sheets with a plain ring. Full always animates.</string>
    <string name="reduce_motion_system">Follow system</string>
    <string name="reduce_motion_reduce">Reduce</string>
    <string name="reduce_motion_full">Full</string>
    <string-array name="ui_scale_names" translatable="false"><item>85%</item><item>100%</item><item>115%</item><item>130%</item><item>150%</item></string-array>
    <string-array name="ui_scale_values" translatable="false"><item>85</item><item>100</item><item>115</item><item>130</item><item>150</item></string-array>
    <string-array name="reduce_motion_names"><item>@string/reduce_motion_system</item><item>@string/reduce_motion_reduce</item><item>@string/reduce_motion_full</item></string-array>
    <string-array name="reduce_motion_values" translatable="false"><item>system</item><item>reduce</item><item>full</item></string-array>
    <!-- tv-mode-toggle -->
    <string name="title_ui_mode">Interface layout</string>
    <string name="summary_ui_mode">Automatic follows the device. Choose TV to lay the app out for a TV, with focus and a remote or gamepad, on a handheld or phone that is connected to one. Choose Handheld for the touch layouts on a TV. The stream is not changed. Takes effect at once.</string>
    <string name="ui_mode_auto">Automatic</string>
    <string name="ui_mode_tv">TV</string>
    <string name="ui_mode_handheld">Handheld</string>
    <string-array name="ui_mode_names"><item>@string/ui_mode_auto</item><item>@string/ui_mode_tv</item><item>@string/ui_mode_handheld</item></string-array>
    <string-array name="ui_mode_values" translatable="false"><item>auto</item><item>tv</item><item>handheld</item></string-array>
