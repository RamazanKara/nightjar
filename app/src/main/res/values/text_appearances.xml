<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Nightjar type scale. Six roles, all in sp so they follow the system font scale. The theme maps
        Material's roles onto them (see Base.Theme.Nightjar), so components and layouts agree:
          ScreenTitle  22sp medium   top app bar titles, dialog titles, empty-state headings  (Title Large)
          Title        18sp medium   PC names, settings sections, sheet headings               (Title Medium)
          Body         16sp          rows, app names, paragraphs, dialog messages              (Body Large)
          Supporting   14sp          summaries and secondary lines under a row                 (Body Medium)
          Label        14sp medium   buttons, chips, category headers, card actions            (Label Large)
          Caption      12sp          badges and status chips                                   (Body Small)
        Letter spacing stays at zero: Material's 0.5sp tracking on body text read loose at these sizes.
    -->
    <style name="TextAppearance.Nightjar.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Nightjar.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Nightjar.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Nightjar.Supporting" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Nightjar.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Nightjar.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Stream statistics: tabular figures that stay aligned while values change. -->
    <style name="TextAppearance.Nightjar.Mono" parent="TextAppearance.Nightjar.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="fontFamily">monospace</item>
    </style>
</resources>
