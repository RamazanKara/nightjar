<?xml version="1.0" encoding="utf-8"?>
<!-- The ring a text, tonal or dialog button draws while focused or hovered; Material's state layer alone is too faint on a TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/colorPrimary" />
    <item android:state_hovered="true" android:color="?attr/colorPrimary" />
    <item android:color="@android:color/transparent" />
</selector>
