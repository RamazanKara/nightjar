<?xml version="1.0" encoding="utf-8"?>
<!-- An amber ring while focused or hovered, so the bar is usable by D-pad, keyboard and mouse. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="?attr/colorPrimary" />
    <item android:state_hovered="true" android:color="?attr/colorPrimary" />
    <item android:color="@android:color/transparent" />
</selector>
