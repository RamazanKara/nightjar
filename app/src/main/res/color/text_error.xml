<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A destructive action that can't run reads as disabled, like every other button: on-surface at 38%. -->
    <item android:state_enabled="false" android:alpha="0.38" android:color="?attr/colorOnSurface" />
    <item android:color="?attr/colorError" />
</selector>
