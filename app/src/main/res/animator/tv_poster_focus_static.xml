<?xml version="1.0" encoding="utf-8"?>
<!-- Reduced motion: a poster does not move on focus; its ring and glow show without fading. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="0" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="0" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="0" android:valueType="floatType" />
        </set>
    </item>
</selector>
