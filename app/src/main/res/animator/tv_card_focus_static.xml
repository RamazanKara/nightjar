<?xml version="1.0" encoding="utf-8"?>
<!-- Reduced motion: the ring changes, nothing zooms and nothing is timed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="0" />
        </set>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="0" />
        </set>
    </item>
    <item android:state_selected="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="0" />
        </set>
    </item>
    <item android:state_hovered="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="0" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="1dp" android:valueType="intType" android:duration="0" />
        </set>
    </item>
</selector>
