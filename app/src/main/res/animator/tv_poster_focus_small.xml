<?xml version="1.0" encoding="utf-8"?>
<!-- A small library poster: it is smaller, so it pops a little more (1.10). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="70" android:interpolator="@interpolator/tv_std" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="70" android:interpolator="@interpolator/tv_std" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:duration="70" android:interpolator="@interpolator/tv_std" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_selected="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_hovered="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.10" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp" android:duration="200" android:interpolator="@interpolator/tv_emph_dec" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="150" android:interpolator="@interpolator/tv_std" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="150" android:interpolator="@interpolator/tv_std" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="150" android:interpolator="@interpolator/tv_std" android:valueType="floatType" />
        </set>
    </item>
</selector>
