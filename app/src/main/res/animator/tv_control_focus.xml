<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.01" android:duration="80" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.01" android:duration="80" />
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="80" />
        </set>
    </item>
    <item android:state_focused="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="160" />
        </set>
    </item>
    <item android:state_selected="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="160" />
        </set>
    </item>
    <item android:state_hovered="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.025" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="3dp" android:valueType="intType" android:duration="160" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="160" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="strokeWidth" android:valueTo="1dp" android:valueType="intType" android:duration="160" />
        </set>
    </item>
</selector>
