<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <!-- Don't sync preferences because it often contains device-specific data -->
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="uniqueid"/>
    <exclude domain="file" path="pin_lock.json"/>
    <exclude domain="file" path="console-library"/>
    <exclude domain="file" path="console"/>
    <exclude domain="file" path="wake_targets.json"/>
    <exclude domain="file" path="hosts.json"/>
    <exclude domain="file" path="host_meta.json"/>
    <exclude domain="file" path="identity.json"/>
    <exclude domain="file" path="identity.json.bad"/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="client.crt"/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="uniqueid"/>
    <exclude domain="file" path="pin_lock.json"/>
    <exclude domain="file" path="console-library"/>
    <exclude domain="file" path="console"/>
    <exclude domain="file" path="wake_targets.json"/>
    <exclude domain="file" path="hosts.json"/>
    <exclude domain="file" path="host_meta.json"/>
    <exclude domain="file" path="identity.json"/>
    <exclude domain="file" path="identity.json.bad"/>
  </device-transfer>
</data-extraction-rules>
