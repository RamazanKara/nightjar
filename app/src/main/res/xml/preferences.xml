            android:dialogMessage="@string/summary_upscaling"
            android:entries="@array/upscaling_names"
            android:entryValues="@array/upscaling_values"
            android:defaultValue="off" />
        <com.limelight.preferences.SeekBarPreference
            android:key="upscaling_sharpness"
            android:title="@string/title_upscaling_sharpness"
            android:dialogMessage="@string/summary_upscaling_sharpness"
            android:defaultValue="50"
            seekbar:min="0"
            android:max="100"
            seekbar:step="1"
            android:text="%" />
        <Preference android:key="checkbox_stretch_video"
            android:title="@string/video_scaling_title" android:persistent="false" />
        <com.limelight.preferences.MaterialListPreference
            android:key="video_alignment"
