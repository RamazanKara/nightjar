        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_vibrate_fallback"
            android:title="@string/title_checkbox_vibrate_fallback"
            android:dialogMessage="@string/summary_checkbox_vibrate_fallback"
