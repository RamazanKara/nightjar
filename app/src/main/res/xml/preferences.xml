            android:title="@string/title_stream_orientation"
            android:dialogMessage="@string/summary_stream_orientation"
            android:entries="@array/stream_orientation_names"
            android:entryValues="@array/stream_orientation_values"
            android:defaultValue="auto" />
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_yuv444"
            android:title="@string/title_yuv444"
            android:dialogMessage="@string/summary_yuv444"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="category_host_display" android:title="@string/settings_category_pc_display">
        <Preference android:key="host_display_location" android:title="@string/host_display_menu"
