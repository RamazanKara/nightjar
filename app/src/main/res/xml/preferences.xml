<?xml version="1.0" encoding="utf-8"?>
<!--
    Global settings. StreamSettings.SECTIONS groups these categories into the screens listed in
    preferences_root.xml, and scripts/generate-settings.py documents them in docs/settings.md.

    Keys are stored user settings: move, retitle or reword rows, but never rename a key.
    Rows show their title and current value. android:summary is an optional short line;
    android:dialogMessage holds the longer explanation, shown in the picker or behind the
    switch's info button. A category without a title continues its section's own heading.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <!-- Video -->
    <PreferenceCategory android:key="category_basic_settings">
        <!-- Opens the named profiles; the summary says which one streams use (StreamSettings). -->
        <Preference
            android:key="stream_profiles"
            android:title="@string/profiles_title"
            android:summary="@string/profiles_summary_none" />
        <com.limelight.preferences.ResolutionPreference
            android:key="list_resolution"
            android:title="@string/title_resolution_list"
            android:dialogMessage="@string/summary_resolution_list"
            android:entries="@array/resolution_names"
            android:entryValues="@array/resolution_values"
            android:defaultValue="1280x720" />
        <!-- The picker also switches between the supported rates and every rate (checkbox_unlock_fps). -->
        <com.limelight.preferences.FpsPreference
            android:key="list_fps"
            android:title="@string/title_fps_list"
            android:dialogMessage="@string/summary_fps_list"
            android:entries="@array/fps_names"
            android:entryValues="@array/fps_values"
            android:defaultValue="60" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_bitrate_kbps"
            android:dialogMessage="@string/dialog_seekbar_bitrate"
            seekbar:min="500"
            android:max="2000000"
            seekbar:step="500"
            seekbar:keyStep="1000"
            seekbar:divisor="1000"
            seekbar:logScale="true"
            seekbar:presets="@array/bitrate_presets_kbps"
            android:text="@string/suffix_seekbar_bitrate_mbps"
            android:title="@string/title_seekbar_bitrate" />
        <!-- Client-hint bitrate over 0x553C (StreamRateChanges); a stream without it keeps Automatic bitrate below. -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_rate_change_bitrate"
            android:title="@string/title_rate_change_bitrate"
            android:dialogMessage="@string/summary_rate_change_bitrate"
            android:defaultValue="false" />
        <!-- The default for every PC; the stream menu's toggle saves a choice for one PC (AutoBitrateChoice). -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_auto_bitrate"
            android:title="@string/title_auto_bitrate"
            android:dialogMessage="@string/dialog_auto_bitrate"
            android:defaultValue="false" />
        <!-- The same feature as the stream menu's Automatic quality; the two minimums show only while it is on
             (StreamSettings, SettingRules). -->
        <com.limelight.preferences.MaterialListPreference
            android:key="adaptive_quality_mode"
            android:title="@string/title_adaptive_quality_setting"
            android:dialogMessage="@string/summary_adaptive_quality_setting"
            android:entries="@array/adaptive_quality_names"
            android:entryValues="@array/adaptive_quality_values"
            android:defaultValue="off" />
        <com.limelight.preferences.MaterialListPreference
            android:key="adaptive_quality_min_resolution"
            android:title="@string/title_adaptive_quality_min_resolution"
            android:dialogMessage="@string/summary_adaptive_quality_min_resolution"
            android:entries="@array/adaptive_quality_resolution_names"
            android:entryValues="@array/adaptive_quality_resolution_values"
            android:defaultValue="720" />
        <com.limelight.preferences.MaterialListPreference
            android:key="adaptive_quality_min_fps"
            android:title="@string/title_adaptive_quality_min_fps"
            android:dialogMessage="@string/summary_adaptive_quality_min_fps"
            android:entries="@array/adaptive_quality_fps_names"
            android:entryValues="@array/adaptive_quality_fps_values"
            android:defaultValue="30" />
        <com.limelight.preferences.MaterialListPreference
            android:key="list_mobile_bitrate_kbps"
            android:title="@string/title_mobile_bitrate"
            android:dialogMessage="@string/summary_mobile_bitrate"
            android:entries="@array/mobile_bitrate_names"
            android:entryValues="@array/mobile_bitrate_values"
            android:defaultValue="0" />
        <com.limelight.preferences.MaterialListPreference
            android:key="video_format"
            android:title="@string/title_video_format"
            android:entries="@array/video_format_names"
            android:entryValues="@array/video_format_values"
            android:dialogMessage="@string/summary_video_format"
            android:defaultValue="auto" />
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_enable_hdr"
            android:title="@string/title_enable_hdr"
            android:dialogMessage="@string/summary_enable_hdr"
            android:defaultValue="false" />
        <!-- 10-bit SDR when HDR is not streamed; the HDR switch above wins (Sdr10Policy). -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_enable_sdr_10bit"
            android:title="@string/title_enable_sdr10"
            android:dialogMessage="@string/summary_enable_sdr10"
            android:defaultValue="false" />
    </PreferenceCategory>

    <!-- Display & image -->
    <PreferenceCategory android:key="category_display_refresh" android:title="@string/settings_category_refresh">
        <!-- Adaptive refresh replaces frame pacing and the lower refresh rate; host frame times replace only frame pacing (StreamSettings, SettingRules). -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_vrr"
            android:title="@string/title_vrr"
            android:dialogMessage="@string/summary_vrr"
            android:disableDependentsState="true"
            android:defaultValue="false" />
        <!-- Applies with adaptive refresh on or off: frames are released at their host frame times. -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_host_frame_times"
            android:title="@string/title_host_frame_times"
            android:dialogMessage="@string/summary_host_frame_times"
            android:defaultValue="false" />
        <!-- Greyed while host frame times replace it. -->
        <com.limelight.preferences.MaterialListPreference
            android:key="frame_pacing"
            android:dependency="checkbox_vrr"
            android:title="@string/title_frame_pacing"
            android:dialogMessage="@string/summary_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:defaultValue="latency" />
        <!-- Part of Balanced frame pacing: shown only with it (StreamSettings, SettingRules). -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_drop_late_frames"
            android:title="@string/title_drop_late_frames"
            android:dialogMessage="@string/summary_drop_late_frames"
            android:defaultValue="true" />
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_reduce_refresh_rate"
            android:dependency="checkbox_vrr"
            android:title="@string/title_checkbox_reduce_refresh_rate"
            android:dialogMessage="@string/summary_checkbox_reduce_refresh_rate"
            android:defaultValue="false" />
        <!-- Needs a host that sends frame times; a vote never changes the mode with a blank screen. Without
             a lower refresh rate allowed the vote cannot drop below the stream's own, so it needs that switch. -->
        <com.limelight.preferences.MaterialSwitchPreference
            android:key="checkbox_content_rate_frame_rate"
            android:dependency="checkbox_reduce_refresh_rate"
            android:title="@string/title_content_rate_frame_rate"
            android:dialogMessage="@string/summary_content_rate_frame_rate"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="category_upscaling" android:title="@string/settings_category_image">
        <com.limelight.preferences.MaterialListPreference
            android:key="upscaling_mode"
