<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Don't sync preferences because it often contains device-specific data -->
    <exclude domain="sharedpref" path="."/>
    <!-- Restoring pairing credentials would clone the host's per-device identity and permissions. -->
    <exclude domain="file" path="client.crt"/>
    <exclude domain="file" path="client.key"/>
    <exclude domain="file" path="uniqueid"/>
</full-backup-content>
