    <string name="title_local_cursor_speed">Szybkość kursora lokalnego</string>
    <string name="title_trackpad_acceleration">Przyspieszenie wskaźnika</string>
    <string name="summary_trackpad_acceleration">Szybkie przesunięcia przenoszą wskaźnik dalej niż wolne, więc małe ruchy pozostają precyzyjne. Dla trybów Touchpad i Kursor lokalny.</string>
