<?xml version="1.0" encoding="utf-8"?>
<!-- A game's page held sideways (a handheld, a phone or tablet in landscape): the TV page's arrangement at phone sizes.
     The cover on the left; its state, title and host, Play, Favourite and Close game in a row, and the stream settings it
     will use on the right, so Play shows without scrolling. The title is on the page, so the bar stays hidden; Back or
     Home in the shell bar leave. The ids are the portrait layout's, so GameDetailActivity fills both. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include android:id="@+id/detail_toolbar" layout="@layout/view_top_app_bar" android:visibility="gone" />
    <include layout="@layout/view_shell_bar" />
    <ProgressBar android:id="@+id/detail_loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:fillViewport="true">
        <com.limelight.ui.ContentFrame android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_m" android:paddingBottom="@dimen/space_xl">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/LibraryCard"
                    android:layout_width="144dp" android:layout_height="192dp" app:cardPreventCornerOverlap="false"
                    android:clipToOutline="true">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="?attr/colorSurfaceContainerHigh">
                        <ImageView android:id="@+id/detail_cover" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:scaleType="centerCrop"
                            android:importantForAccessibility="no" />
                        <TextView android:id="@+id/detail_cover_text" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:gravity="center" android:padding="@dimen/space_m"
                            android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface"
                            android:maxLines="5" android:ellipsize="end" android:importantForAccessibility="no" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_xl" android:orientation="vertical">
                    <TextView android:id="@+id/detail_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_s"
                        android:paddingStart="@dimen/space_s" android:paddingEnd="@dimen/space_s"
                        android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs"
                        android:background="@drawable/bg_chip" android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Nightjar.Label" android:textColor="?attr/colorOnSurface"
                        android:visibility="gone" />
                    <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Nightjar.ScreenTitle" android:textColor="?attr/colorOnSurface"
                        android:maxLines="2" android:ellipsize="end" android:accessibilityHeading="true" />
                    <TextView android:id="@+id/detail_host" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:drawableStart="@drawable/tv_ic_host_line" android:drawablePadding="@dimen/space_s"
                        app:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurfaceVariant"
                        android:maxLines="1" android:ellipsize="end" />
                    <TextView android:id="@+id/detail_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
                        android:accessibilityLiveRegion="polite" android:visibility="gone" />
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l" android:scrollbars="none" android:overScrollMode="never"
                        android:clipToPadding="false" android:focusable="false">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/detail_play"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="160dp" android:minHeight="@dimen/touch_target"
                                android:text="@string/library_play" app:icon="@drawable/ic_play"
                                android:nextFocusRight="@+id/detail_favourite" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/detail_favourite"
                                style="@style/Widget.Nightjar.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s" android:minHeight="@dimen/touch_target"
                                android:text="@string/console_favourite_add" app:icon="@drawable/ic_star"
                                android:nextFocusLeft="@id/detail_play" android:nextFocusRight="@+id/detail_end" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/detail_end"
                                style="@style/Widget.Nightjar.Button.Tonal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s" android:minHeight="@dimen/touch_target"
                                android:text="@string/stream_close_game" app:icon="@drawable/ic_stop" android:visibility="gone"
                                android:nextFocusLeft="@id/detail_favourite" />
                        </LinearLayout>
                    </HorizontalScrollView>
                    <com.google.android.material.card.MaterialCardView style="@style/LibraryCard"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:padding="@dimen/space_l">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/console_detail_profile"
                                android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurfaceVariant" />
                            <TextView android:id="@+id/detail_profile_values" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                                android:textAppearance="@style/TextAppearance.Nightjar.Title" android:textColor="?attr/colorOnSurface" />
                            <TextView android:id="@+id/detail_profile_layers" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs"
                                android:maxLines="2" android:ellipsize="end"
                                android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <include layout="@layout/view_detail_quit_on_leave" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_s" />
                </LinearLayout>
            </LinearLayout>
        </com.limelight.ui.ContentFrame>
    </ScrollView>
</LinearLayout>
