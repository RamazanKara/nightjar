<?xml version="1.0" encoding="utf-8"?>
<!-- A game's page held sideways (a handheld, a phone or tablet in landscape): Home's hero as a page of its own. The
     game's ambient lies behind it, carried over from Home (BackdropView.adopt), so opening a game keeps the screen's
     light. The 2:3 cover on the left; beside it the chips (state, store, installed, HDR), the title at the hero's size,
     the PC, the moon Play with Favourite and Quit game as glass capsules, and the stream settings it will use on a
     panel, so Play shows without scrolling. The title is on the page, so the bar stays hidden; Back or Home in the
     shell bar leave. The ids are the portrait and TV layouts', so GameDetailActivity fills all three. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipChildren="false" android:clipToPadding="false">
    <com.limelight.ui.BackdropView android:id="@+id/detail_backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:clipChildren="false" android:clipToPadding="false">
        <include android:id="@+id/detail_toolbar" layout="@layout/view_top_app_bar" android:visibility="gone" />
        <FrameLayout android:id="@+id/detail_top_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs"
            android:clipChildren="false" android:clipToPadding="false">
            <com.limelight.ui.GlassButton android:id="@+id/detail_back" style="@style/Widget.Nightjar.Glass.Control"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:minWidth="48dp" android:minHeight="48dp"
                android:singleLine="true" android:maxLines="1"
                android:text="@string/sheet_back" app:icon="@drawable/ic_arrow_back"
                android:nextFocusDown="@+id/detail_play" />
        </FrameLayout>
        <ProgressBar android:id="@+id/detail_loading" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
        <ScrollView android:id="@+id/detail_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:clipChildren="false" android:fillViewport="true"
            android:scrollbars="none">
            <com.limelight.ui.ContentFrame android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter"
                android:paddingTop="@dimen/space_l" android:paddingBottom="@dimen/space_xl">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
                    <com.google.android.material.card.MaterialCardView android:id="@+id/detail_poster" style="@style/LibraryPoster"
                        android:layout_width="@dimen/detail_cover_land_width" android:layout_height="@dimen/detail_cover_land_height"
                        app:cardPreventCornerOverlap="false" app:cardBackgroundColor="@android:color/transparent"
                        android:clipToOutline="true">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
                            android:background="?attr/colorSurfaceContainerHigh">
                            <com.limelight.ui.PosterImageView android:id="@+id/detail_cover" android:layout_width="match_parent"
                                android:layout_height="match_parent" android:scaleType="centerCrop"
                                android:importantForAccessibility="no" />
                            <com.limelight.ui.NoArtTile android:id="@+id/detail_cover_text" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_xl" android:orientation="vertical"
                        android:clipChildren="false" android:clipToPadding="false">
                        <!-- Running or suspended (with its dot), the store (its glyph and name), installed or not, HDR: Home's
                             chips. A screen reader hears the line as one stop, from the content description
                             GameDetailActivity joins from the shown chips. -->
                        <LinearLayout android:id="@+id/detail_chips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:visibility="gone" android:importantForAccessibility="yes">
                            <TextView android:id="@+id/detail_status" style="@style/Widget.Nightjar.DetailChip"
                                android:layout_marginEnd="6dp" android:visibility="gone" />
                            <TextView android:id="@+id/detail_store" style="@style/Widget.Nightjar.DetailChip"
                                android:layout_marginEnd="6dp" android:visibility="gone" />
                            <TextView android:id="@+id/detail_installed" style="@style/Widget.Nightjar.DetailChip"
                                android:layout_marginEnd="6dp" android:visibility="gone" />
                            <TextView android:id="@+id/detail_hdr" style="@style/Widget.Nightjar.DetailChip"
                                android:text="@string/host_profile_hdr" android:visibility="gone" />
                        </LinearLayout>
                        <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.Nightjar.Glass.Hero" android:textColor="?attr/colorOnSurface"
                            android:maxLines="2" android:ellipsize="end" android:accessibilityHeading="true" />
                        <TextView android:id="@+id/detail_host" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:drawableStart="@drawable/tv_ic_host_line" android:drawablePadding="@dimen/space_s"
                            app:drawableTint="?attr/colorOnSurfaceVariant" android:gravity="center_vertical"
                            android:textAppearance="@style/TextAppearance.Nightjar.Body" android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/detail_note" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
                            android:accessibilityLiveRegion="polite" android:visibility="gone" />
                        <!-- Quit game drops to its own line when the row is full, as a capsule like the others. -->
                        <com.limelight.ui.WrapRow android:id="@+id/detail_actions"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_l"
                            android:clipChildren="false" android:clipToPadding="false">
                            <com.limelight.ui.GlassButton android:id="@+id/detail_play" style="@style/Widget.Nightjar.Glass.Play"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:minWidth="160dp" android:minHeight="52dp"
                                android:text="@string/library_play"
                                android:nextFocusRight="@+id/detail_favourite" />
                            <!-- No nextFocusRight to detail_end: it is gone unless the game runs, and Android 7.1 and older stop on a gone target. -->
                            <com.limelight.ui.GlassButton android:id="@+id/detail_favourite" style="@style/Widget.Nightjar.Glass.Control"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s" android:minHeight="52dp"
                                android:text="@string/console_favourite_add" app:icon="@drawable/ic_star"
                                android:nextFocusLeft="@id/detail_play" />
                            <com.limelight.ui.GlassButton android:id="@+id/detail_end" style="@style/Widget.Nightjar.Glass.Control"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s" android:minHeight="52dp"
                                android:text="@string/applist_menu_quit" app:icon="@drawable/ic_glass_power" android:visibility="gone"
                                android:nextFocusLeft="@id/detail_favourite" />
                        </com.limelight.ui.WrapRow>
                        <!-- Studio card container grouping stream profile, quit-on-leave, and controller rows. -->
                        <LinearLayout android:id="@+id/detail_studio_card" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_l"
                            android:orientation="vertical" android:background="@drawable/glass_group"
                            android:clipToOutline="true">
                            <FrameLayout android:id="@+id/detail_profile" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:clickable="true" android:focusable="true" android:foreground="@drawable/focus_ring_row">
                                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/space_l" android:paddingEnd="@dimen/space_l"
                                    android:paddingTop="@dimen/space_m" android:paddingBottom="@dimen/space_m">
                                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                        android:text="@string/console_detail_profile"
                                        android:textAppearance="@style/TextAppearance.Nightjar.Caption" android:textColor="?attr/colorOnSurfaceVariant" />
                                    <TextView android:id="@+id/detail_profile_values" android:layout_width="match_parent"
                                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                                        android:textAppearance="@style/TextAppearance.Nightjar.Body" android:fontFamily="?attr/nightjarFaceStrong"
                                        android:textColor="?attr/colorOnSurface" />
                                    <TextView android:id="@+id/detail_profile_layers" android:layout_width="match_parent"
                                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                                        android:maxLines="2" android:ellipsize="end"
                                        android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant" />
                                </LinearLayout>
                            </FrameLayout>
                            <View android:id="@+id/detail_quit_divider" android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginStart="@dimen/detail_row_padding" android:layout_marginEnd="@dimen/detail_row_padding"
                                android:background="?attr/glassSeparator" android:visibility="gone" />
                            <include layout="@layout/view_detail_quit_on_leave" android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <View android:id="@+id/detail_controller_divider" android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginStart="@dimen/detail_row_padding" android:layout_marginEnd="@dimen/detail_row_padding"
                                android:background="?attr/glassSeparator" />
                            <include layout="@layout/view_detail_controller" android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.limelight.ui.ContentFrame>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
