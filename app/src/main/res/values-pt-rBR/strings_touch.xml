    <string name="title_trackpad_acceleration">Aceleração do ponteiro</string>
    <string name="summary_trackpad_acceleration">Deslizes rápidos movem o ponteiro mais longe que os lentos, então movimentos pequenos continuam precisos. Para Trackpad e Cursor local.</string>
