<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="title_checkbox_enable_mic">將麥克風傳送至電腦</string>
    <string name="summary_checkbox_enable_mic">當主機支援時，電腦上的遊戲和聊天應用程式可以聽到這部裝置的麥克風</string>
    <string name="mic_permission_denied">未取得麥克風存取權，因此麥克風會保持關閉。請在 Android 設定中允許存取，才能透過電腦通話。</string>
    <string name="mic_status_sending">麥克風：傳送中</string>
    <string name="mic_status_muted">麥克風：已靜音</string>
    <string name="mic_status_not_offered">麥克風：主機未提供</string>
    <string name="mic_status_unavailable">麥克風：無法使用</string>
    <string name="mic_status_no_permission">麥克風：需要權限</string>
    <string name="title_list_mic_echo_cancel">回音消除</string>
    <string name="summary_list_mic_echo_cancel">防止喇叭裡的遊戲聲音進入麥克風。自動模式在使用喇叭時開啟，使用耳機和藍牙耳機時關閉，並在串流中切換時跟著改變。</string>
    <string name="mic_echo_auto">自動</string>
    <string name="mic_echo_on">開啟</string>
    <string name="mic_echo_off">關閉</string>
    <string name="title_checkbox_mic_noise_suppression">噪音抑制</string>
    <string name="summary_checkbox_mic_noise_suppression">濾除麥克風中風扇等持續的背景噪音</string>
    <string name="title_checkbox_mic_auto_gain">自動增益</string>
    <string name="summary_checkbox_mic_auto_gain">讓裝置平衡小聲和大聲的說話。下方的麥克風增益會在此之上套用。</string>
    <string name="title_seekbar_mic_gain">麥克風增益</string>
    <string name="summary_seekbar_mic_gain">在傳送前調低或調高麥克風。響亮的峰值會被圓滑處理而不會削波。</string>
    <string name="title_checkbox_mic_button">麥克風按鈕</string>
    <string name="summary_checkbox_mic_button">在串流畫面上顯示一個用來靜音和取消靜音麥克風的按鈕。拖曳即可移動。</string>
    <string name="mic_button_mute">將麥克風靜音</string>
    <string name="mic_button_unmute">取消麥克風靜音</string>
    <string name="stream_mic_button_show">顯示麥克風按鈕</string>
    <string name="stream_mic_button_hide">隱藏麥克風按鈕</string>
    <string name="mic_effects_missing">此裝置不支援：%1$s。麥克風會在沒有這些處理的情況下傳送。</string>
    <string name="mic_effect_not_on_device">此裝置不支援</string>
</resources>
