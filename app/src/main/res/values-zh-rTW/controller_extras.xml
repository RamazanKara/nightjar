<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Controller and keyboard options -->
    <string name="title_checkbox_disable_rumble">停用震動</string>
    <string name="summary_checkbox_disable_rumble">停止遊戲要求的所有震動：控制器與扳機震動、USB DualSense 觸覺回饋，以及這部裝置代替控制器的震動。</string>
    <string name="title_checkbox_mouse_emulation_fixed_step">以固定步距移動滑鼠</string>
    <string name="summary_checkbox_mouse_emulation_fixed_step">在控制器滑鼠模式下，移動搖桿時按住 X，指標每次會移動固定的像素數。按 Y 可將步距加倍，從 1 增加到 128 像素，然後回到 1。</string>
    <string name="stream_mouse_step">滑鼠步距：%1$d 像素</string>
    <string name="title_checkbox_back_as_meta">鍵盤返回鍵傳送 Windows 鍵</string>
    <string name="summary_checkbox_back_as_meta">實體鍵盤上的返回鍵會傳送 Windows 鍵（在 Mac 上為 Command）。請使用 Ctrl+Alt+Shift+M、Android 的返回手勢或按鈕，或控制器組合鍵開啟串流選單。</string>
    <string name="title_checkbox_right_alt_as_meta">右 Alt 作為 Command</string>
    <string name="summary_checkbox_right_alt_as_meta">右 Alt 會傳送 Windows 鍵，Mac 會將其當作 Command，因此右 Alt+C 即可複製。左 Alt 不變。如果你用 AltGr 輸入字元，請保持關閉。</string>
    <string name="title_checkbox_keyboard_follows_text_fields">鍵盤跟隨文字欄位</string>
    <string name="summary_checkbox_keyboard_follows_text_fields">串流中的文字欄位取得焦點時，螢幕鍵盤會依該欄位開啟：數字欄位顯示數字鍵盤，密碼欄位不顯示建議字詞。文字欄位失去焦點時鍵盤會關閉。連接實體鍵盤時，仍以實體鍵盤輸入。</string>

