<?xml version="1.0" encoding="utf-8"?>
<!-- High contrast with reduced motion: the tile's thick ring, with no fade. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/tv_tile_ring_shape_hc" />
    <item android:state_focused="true" android:drawable="@drawable/tv_tile_ring_shape_hc" />
    <item android:state_selected="true" android:drawable="@drawable/tv_tile_ring_shape_hc" />
    <item android:state_hovered="true" android:drawable="@drawable/tv_tile_ring_shape_hc" />
    <item android:drawable="@android:color/transparent" />
</selector>
