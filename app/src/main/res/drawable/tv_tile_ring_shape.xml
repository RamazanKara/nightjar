<?xml version="1.0" encoding="utf-8"?>
<!-- A PC tile's focus ring, as the poster's (tv_poster_ring_shape) around the tile's 16dp corners: the view extends 5dp past
     the card; 3dp amber from 1dp to 4dp out, then a 1dp hairline against the art. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2.5dp" android:bottom="2.5dp" android:left="2.5dp" android:right="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="18.5dp" />
            <stroke android:width="3dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:top="4.5dp" android:bottom="4.5dp" android:left="4.5dp" android:right="4.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16.5dp" />
            <stroke android:width="1dp" android:color="@color/tv_ring_hairline" />
        </shape>
    </item>
</layer-list>
