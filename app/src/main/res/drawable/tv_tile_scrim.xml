<?xml version="1.0" encoding="utf-8"?>
<!-- Under a PC tile's name and status line: clear at the top, half black by the name, 80% black at the foot, so the
     text reads over any cover. With BackdropBlur.TILE_DARKEN a white cover still gives the name well over 4.5:1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient android:angle="270" android:startColor="#00000000" android:centerColor="#80000000" android:endColor="#CC000000" />
</shape>
