<?xml version="1.0" encoding="utf-8"?>
<!--
    The Touch Controller Studio dock's surface, baked: the studio's opaque fill and its rim. No blur and no shadow, so
    it costs the stream under it nothing.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nj_pad_studio_inspector_fill" />
    <stroke android:width="1dp" android:color="@color/nj_pad_studio_inspector_rim" />
    <corners android:radius="16dp" />
</shape>
