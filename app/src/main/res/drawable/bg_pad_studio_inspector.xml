<?xml version="1.0" encoding="utf-8"?>
<!--
    The Touch Controller Studio dock's surface, baked: the studio's fill and its rim, laid on black so that no control
    behind the dock reads through its text. No blur and no shadow, so it costs the stream under it nothing.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/black" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nj_pad_studio_inspector_fill" />
            <stroke android:width="1dp" android:color="@color/nj_pad_studio_inspector_rim" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
