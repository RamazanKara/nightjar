<?xml version="1.0" encoding="utf-8"?>
<!-- The outline every focusable row and button on a settings sub-page shows when it has focus (list_focus_row is the list version). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="1dp" android:insetBottom="1dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <stroke android:width="?attr/nightjarFocusRingWidth" android:color="?attr/colorPrimary" />
            </shape>
        </inset>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
