<com.limelight.ui.ContentFrame xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="@dimen/shell_overscan_horizontal" android:paddingEnd="@dimen/shell_overscan_horizontal"
        android:paddingTop="@dimen/shell_overscan_vertical" android:paddingBottom="@dimen/shell_overscan_vertical">
        <include android:id="@+id/settings_toolbar" layout="@layout/view_top_app_bar" />
        <include layout="@layout/view_shell_bar" />
        <androidx.appcompat.widget.SearchView android:id="@+id/settings_search"
            android:nextFocusDown="@android:id/list" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:layout_marginStart="@dimen/screen_gutter" android:layout_marginEnd="@dimen/screen_gutter"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/settings_search_background"
            app:queryBackground="@android:color/transparent" app:submitBackground="@android:color/transparent"
            app:iconifiedByDefault="false" />
        <TextView android:id="@+id/settings_context"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_gutter" android:paddingEnd="@dimen/screen_gutter" android:paddingBottom="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Nightjar.Supporting" android:textColor="?attr/colorOnSurfaceVariant"
            android:accessibilityLiveRegion="polite" />
        <!-- Two panes: the sections on the left (RootFragment), the chosen section or the search results on the right. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/settings_sections"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"
                android:nextFocusRight="@id/stream_settings" />
            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_s" android:layout_marginBottom="@dimen/space_s"
                android:background="?attr/colorOutlineVariant" android:importantForAccessibility="no" />
            <FrameLayout android:id="@+id/stream_settings"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:nextFocusLeft="@id/settings_sections" />
        </LinearLayout>
    </LinearLayout>
</com.limelight.ui.ContentFrame>
